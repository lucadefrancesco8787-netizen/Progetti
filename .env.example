# Copia questo file in ".env" e modifica i valori.
# Su un server basta impostare queste stesse variabili d'ambiente.

# Porta su cui gira il sito
PORT=3000

# Database: percorso del file SQLite (in futuro si può passare a PostgreSQL)
DATABASE_PATH=./data/zetaclub.db

# Cartella dove vengono salvati i curriculum caricati
UPLOAD_DIR=./data/uploads

# Dimensione massima di un curriculum, in MB
MAX_UPLOAD_MB=5

# Password per vedere l'elenco delle candidature su /api/candidature (cambiala!)
ADMIN_TOKEN=cambia-questa-password
