# Copia questo file in ".env" e modifica i valori.
# Su un server basta impostare queste stesse variabili d'ambiente.

# Porta su cui gira il sito
PORT=3000

# Database: percorso del file SQLite (in futuro si può passare a PostgreSQL)
DATABASE_PATH=./data/zetaclub.db

# Cartella dove vengono salvati i curriculum caricati
UPLOAD_DIR=./data/uploads

# Dimensione massima di un curriculum, in MB
MAX_UPLOAD_MB=5

# Area riservata
# true = al primo avvio crea gli account di prova e i dati dimostrativi (metti false in produzione)
SEED_DEMO=true
# true quando il sito è servito in HTTPS (produzione)
COOKIE_SECURE=false
# Durata del login, in giorni
SESSION_DAYS=7
# Proxy davanti al sito: loopback (Nginx/Caddy sullo stesso server) oppure il numero di proxy (1 su Render)
TRUST_PROXY=loopback

# Password per vedere l'elenco delle candidature su /api/candidature (cambiala!)
ADMIN_TOKEN=cambia-questa-password

# Anteprima protetta: se SITE_PASSWORD è impostata, tutto il sito chiede utente e password
# (utile quando lo si mostra con un link temporaneo; lasciare vuota in produzione)
SITE_USER=zetaclub
SITE_PASSWORD=
